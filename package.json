{
  "name": "mnwdd",
  "version": "0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -rkP 'pnpm dev:shopify {@}' 'pnpm dev:vite'",
    "dev:vite": "vite",
    "dev:shopify": "shopify theme dev -e dev",
    "build": "vite build",
    "push": "pnpm build && pnpm push:shopify",
    "push:shopify": "shopify theme push -e dev",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint --cache ."
  },
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^2.2.0",
    "@eslint/js": "^9.28.0",
    "@shopify/eslint-plugin": "^50.0.0",
    "@shopify/prettier-plugin-liquid": "^1.9.3",
    "eslint": "^9.28.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "lucide-static": "^0.483.0",
    "postcss": "^8.5.4",
    "postcss-preset-env": "^10.2.1",
    "prettier": "^3.5.3",
    "vite": "^6.3.5",
    "vite-plugin-shopify": "^4.0.1",
    "vite-plugin-shopify-assets": "^1.0.0"
  }
}
